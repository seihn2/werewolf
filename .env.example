WOLFPLAY_BASE_URL=https://api.example.com/v1
WOLFPLAY_API_KEY=replace-me
WOLFPLAY_MODEL=your-chat-model

WOLFPLAY_EMBEDDING_BASE_URL=https://api.example.com/v1
WOLFPLAY_EMBEDDING_API_KEY=replace-me
WOLFPLAY_EMBEDDING_MODEL=your-embedding-model

WOLFPLAY_CHALLENGER_BASE_URL=http://127.0.0.1:8001/v1
WOLFPLAY_CHALLENGER_API_KEY=replace-me
WOLFPLAY_CHALLENGER_MODEL=wolfplay-dpo

WOLFPLAY_BASELINE_BASE_URL=http://127.0.0.1:8002/v1
WOLFPLAY_BASELINE_API_KEY=replace-me
WOLFPLAY_BASELINE_MODEL=base-model

# Optional per-iteration model service used by `wolfplay iterate-policy`.
WOLFPLAY_ITERATION_2_BASE_URL=http://127.0.0.1:8012/v1
WOLFPLAY_ITERATION_2_API_KEY=replace-me
WOLFPLAY_ITERATION_2_MODEL=wolfplay-dpo-iteration-1
